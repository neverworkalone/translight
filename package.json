{
  "name": "translight",
  "version": "1.0.0",
  "private": true,
  "description": "Keep the original text and display the translation below.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "TRANSLIGHT_BUILD_MODE=production npm run build:extension",
    "build:test": "TRANSLIGHT_BUILD_MODE=test npm run build:extension",
    "build:extension": "vite build && vite build --config vite.content.config.js",
    "benchmark:collector": "node tests/benchmarks/block-collector-visibility.mjs",
    "icons:active": "node scripts/create-active-icons.mjs",
    "package": "bash pack.sh --minify",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:metacritic:chrome": "node tests/fixtures/metacritic-chrome-runner.mjs",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "ws": "^8.21.3"
  }
}
